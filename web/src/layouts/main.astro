---
// Mirrors the layout of the personal site (Gippers/gippers.github.io, src/layouts/main.astro) so the
// dashboard reads as part of thomasmartin.id.au. Keep the two in step when the site header changes.
import "@/styles/global.css"
import { Icon } from "astro-icon/components"
import { ModeToggle } from "@/components/ModeToggle"
interface Props {
  title?: string
  description?: string
}
const {
  title = "Solomon Islands Data Map · Tom Martin",
  description = "An interactive map of the Solomon Islands 2009 census, population projections and 2024 election results.",
} = Astro.props
const home = (path: string) => new URL(path, Astro.site).toString()
const nav = [
  { href: home("/"), label: "Home" },
  { href: home("/projects/"), label: "Projects", active: true },
  { href: home("/about/"), label: "About" },
]
const base = import.meta.env.BASE_URL.replace(/\/$/, "")
const url = new URL(Astro.url.pathname, Astro.site)
const ogImage = home("/projects/solMap.png")
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="canonical" href={url} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      const getThemePreference = () => {
        if (
          typeof localStorage !== "undefined" &&
          localStorage.getItem("theme")
        ) {
          return localStorage.getItem("theme")
        }
        return window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light"
      }
      const isDark = getThemePreference() === "dark"
      document.documentElement.classList[isDark ? "add" : "remove"]("dark")

      if (typeof localStorage !== "undefined") {
        const observer = new MutationObserver(() => {
          const isDark = document.documentElement.classList.contains("dark")
          localStorage.setItem("theme", isDark ? "dark" : "light")
        })
        observer.observe(document.documentElement, {
          attributes: true,
          attributeFilter: ["class"],
        })
      }
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <header class="border-b">
      <nav class="flex h-14 items-center justify-between gap-4 px-4">
        <div class="flex min-w-0 items-center gap-2 font-mono text-sm">
          <a href={home("/")} class="hidden font-medium sm:block">
            thomasmartin.id.au
          </a>
          <span class="hidden text-muted-foreground sm:block">/</span>
          <a href={`${base}/`} class="truncate font-medium text-foreground">
            Solomon Islands Data Map
          </a>
        </div>

        <div class="flex items-center gap-6">
          <ul class="hidden gap-6 text-sm md:flex">
            {nav.map((l) => (
              <li>
                <a
                  href={l.href}
                  class:list={[
                    "hover:text-foreground",
                    l.active ? "text-foreground" : "text-muted-foreground",
                  ]}
                >
                  {l.label}
                </a>
              </li>
            ))}
          </ul>

          <div class="flex items-center gap-2">
            <a
              href="https://github.com/Gippers/SolomonIslandsDataMap"
              aria-label="Source code on GitHub"
              class="inline-flex size-9 items-center justify-center border text-muted-foreground hover:bg-muted hover:text-foreground"
            >
              <Icon name="simple-icons:github" class="size-4" />
            </a>
            <ModeToggle client:load />
          </div>
        </div>
      </nav>
    </header>
    <div class="flex flex-1 flex-col">
      <slot />
    </div>
    <footer class="border-t">
      <div class="flex flex-wrap justify-between gap-2 px-4 py-6 text-sm text-muted-foreground">
        <span>© {new Date().getFullYear()} Tom Martin</span>
        <span>
          Data: Solomon Islands 2009 Census and population projections, 2024
          national election results ·{" "}
          <a
            class="underline underline-offset-4 hover:text-foreground"
            href={`${base}/docs/`}
          >
            Python docs
          </a>
        </span>
      </div>
    </footer>
  </body>
</html>
